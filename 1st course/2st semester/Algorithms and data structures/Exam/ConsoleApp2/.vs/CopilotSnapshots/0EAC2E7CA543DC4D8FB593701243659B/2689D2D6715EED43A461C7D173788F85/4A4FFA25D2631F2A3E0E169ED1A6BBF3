    static int BinarySearch(int[] arr, int el)
    {

    {
      if (arr == null || arr.Length == 0)
        return -1;

      int left = 0;
      int right = arr.Length - 1;

      while (left <= right)
      {
        int mid = left + (right - left) / 2;
        if (arr[mid] == el)
          return mid;
        if (arr[mid] < el)
          left = mid + 1;
        else
          right = mid - 1;
      }

      return -1;
    }

